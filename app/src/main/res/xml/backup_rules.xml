<?xml version="1.0" encoding="utf-8"?><!--
   备份规则(API 31 以下使用本文件;API 31+ 见 data_extraction_rules.xml)
   见 https://developer.android.com/guide/topics/data/autobackup

    users 表的 cookie_token / ltoken / stoken 现由 CookieConverter 加密存储
    (AES-GCM,密钥在 AndroidKeyStore 且**不参与备份**),但 DataStore 内含
    device_fp,故仍必须排除数据库与 DataStore:
      - 数据库:除 token 外仍含其它账号信息
      - DataStore:device_fp / device_id 是设备身份,不应跨设备迁移
    注意:密钥不入备份,所以"备份里带密文"本身也不构成可用凭证。
-->
<full-backup-content>
    <!-- 排除数据库(users 表 token 已加密,但仍含其它账号信息) -->
    <exclude domain="database" path="." />

    <!-- 排除 DataStore(含 device_fp / device_id 等设备身份) -->
    <exclude domain="file" path="datastore" />
    <exclude domain="file" path="datastorePf.preferences_pb" />

    <!-- 排除图片缓存与元数据(体积大且可重新下载) -->
    <exclude domain="file" path="image_cache" />
    <exclude domain="external" path="metadata" />

    <!--
    排除 WebView 数据目录。
    HoyolabWebActivity 会把 cookie_token/ltoken/stoken 写入 CookieManager,
    WebView 将 .mihoyo.com/.miyoushe.com 的 cookie 持久化在 app_webview/ 下,
    而该目录位于 getDataDir()(root域),默认会被云备份/换机迁移带走 ——
    仅排除 database 与 datastore 并不够,账号 cookie 仍会泄漏。
    -->
    <exclude domain="root" path="app_webview" />

    <!-- 排除导出的祈愿/成就记录与下载的安装包(可重新生成,且非必要) -->
    <exclude domain="external" path="gacha" />
    <exclude domain="external" path="achievements" />
    <exclude domain="external" path="package" />
</full-backup-content>
